# mod-notify-discord.env — Discord webhook for the hs-mod-check-discord alert.
#
# The REAL file is NEVER committed. Install it to:
#     /etc/home-server/mod-notify-discord.env      (owner root:root, chmod 600)
# systemd/hs-mod-check-discord.service loads it via EnvironmentFile, so this becomes an
# env var for notify-mod-updates-discord.sh. (*.env is gitignored; only this .example is
# kept.)
#
# Get a webhook URL in Discord:
#     Server Settings -> Integrations -> Webhooks -> New Webhook -> (pick a channel) ->
#     Copy Webhook URL
# It looks like:
#     https://discord.com/api/webhooks/<id>/<token>
#
# This can be the same webhook the status reporter uses (valheim-status.env) or a
# different channel — they are independent.

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_WEBHOOK_ID/REPLACE_WITH_TOKEN
