# valheim-status.env — Discord webhook for the hs-valheim-status heartbeat (posts the
# server up/down + players-online every 30 min).
#
# The REAL file is NEVER committed. Install it to:
#     /etc/home-server/valheim-status.env      (owner root:root, chmod 600)
# systemd/hs-valheim-status.service loads it via EnvironmentFile, so these become env
# vars for server-status-discord.sh. (*.env is gitignored; only this .example is kept.)
#
# Get a webhook URL in Discord:
#     Server Settings -> Integrations -> Webhooks -> New Webhook -> (pick a channel) ->
#     Copy Webhook URL       ->  https://discord.com/api/webhooks/<id>/<token>
# Can be the same webhook as mod-notify-discord.env or a different channel.

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_WEBHOOK_ID/REPLACE_WITH_TOKEN

# Optional overrides (defaults shown) — usually leave commented:
#VALHEIM_VMID=100
#VALHEIM_CONTAINER=valheim
