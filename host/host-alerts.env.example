# host-alerts.env — SMTP credentials for host-level alert emails (hs-tmp-watch).
#
# The REAL file is NEVER committed. Install it to:
#     /etc/home-server/host-alerts.env      (owner root:root, chmod 600)
# systemd/hs-tmp-watch.service loads it via EnvironmentFile, so these become env
# vars for host/hs-tmp-watch.sh. Same keys as valheim-server's mod-notify.env, so
#     sudo install -m 600 /etc/home-server/mod-notify.env /etc/home-server/host-alerts.env
# is a valid way to stage it.
#
# Gmail requires an APP PASSWORD, not the account password:
#     https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_FROM=you@example.com
MAIL_TO=you@example.com
