# steam-price-tracker SMTP credentials + recipient — TEMPLATE (location doc only).
#
# The LIVE file is /etc/home-server/steam-tracker.env (root-owned, chmod 600),
# created BY HAND — never committed. This .example is the tracked template; never
# put the real password here. The refresh unit loads the live file via
# `EnvironmentFile=-/etc/home-server/steam-tracker.env` (the leading '-' means a
# missing file is not an error — the price fetch still runs, email just stays off).
#
# Install (as root):
#   umask 077
#   cp /srv/dev/repos/home-server/steam-tracker/steam-tracker.env.example \
#      /etc/home-server/steam-tracker.env
#   # edit in the three values below, then:
#   chmod 600 /etc/home-server/steam-tracker.env
#
# Gmail requires a 16-char App Password (2-Step Verification on for the sending
# account) — not the normal account password. Email turns on only when ALL THREE
# vars below are set; absent any of them, the tracker just fetches prices and
# logs console alerts into the journal.
STEAM_TRACKER_SMTP_USER=your.sender@gmail.com
STEAM_TRACKER_SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Recipient of the alert emails (a personal address — treated as a secret, so it
# lives here alongside the credentials, not in any committed file).
STEAM_TRACKER_EMAIL_TO=your.recipient@example.com
