# gta6-emulation-watcher SMTP credentials + recipient -- TEMPLATE (location doc only).
#
# The LIVE file is /etc/home-server/gta6-watcher.env (root-owned, chmod 600), created
# BY HAND -- never committed. hs-gta6-watch.service loads it via
# `EnvironmentFile=-/etc/home-server/gta6-watcher.env` (the leading '-' means a missing
# file is not an error: the digest still runs and lands in the journal, email stays off).
#
# Same keys as host-alerts.env, so the quickest way to stage it (as root) is:
#   install -m 600 /etc/home-server/host-alerts.env /etc/home-server/gta6-watcher.env
#
# Gmail requires an APP PASSWORD, not the account password:
#     https://myaccount.google.com/apppasswords
# Email turns on only when SMTP_USER, SMTP_PASS, MAIL_FROM and MAIL_TO are all set.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_FROM=you@example.com
MAIL_TO=you@example.com

# Optional behaviour overrides (non-secret; see the watcher repo's .env.example):
# GTA6_WATCH_ALWAYS_EMAIL=1
