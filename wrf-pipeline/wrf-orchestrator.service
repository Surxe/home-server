[Unit]
Description=WRF Pipeline Orchestrator
Documentation=file:///srv/dev/repos/WRFrontiersDB-Orchestrator/README.md
After=network-online.target
# Pull in and order after the WRF data-volume mount (WRF_ROOT). A raw path in
# After=/Requires= is silently rejected ("Invalid argument"); RequiresMountsFor is
# the correct form — it adds both the Requires and the After on srv-dev-wrf.mount.
RequiresMountsFor=/srv/dev/wrf

[Service]
Type=oneshot
User=dev
Group=dev
WorkingDirectory=/srv/dev/repos/WRFrontiersDB-Orchestrator
ExecStart=/srv/dev/repos/WRFrontiersDB-Orchestrator/.venv/bin/python src/run.py --patch-day --game-version=%i --log-dir /srv/dev/wrf/logs

# Secrets: STEAM_USERNAME, STEAM_PASSWORD, GH_DATA_REPO_PAT, and (optional, for the
# run-report email) SMTP_USER, SMTP_PASSWORD, EMAIL_TO. EnvironmentFile loads every
# line in the file, so the optional email vars just need to be present there.
EnvironmentFile=/etc/home-server/wrf-orchestrator.env

# GPU runtime for headless mapper. This PATH serves EXPORT/PARSE; the SITE stage's
# `npm` is added by the install-time drop-in 10-node-path.conf (nvm's node bin dir).
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="PATH=/usr/games:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Suppress inherited DISPLAY (pure headless)
UnsetEnvironment=DISPLAY

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wrf-orchestrator

# Timeouts: the export stage can take 30+ minutes (Proton startup, mapper dump)
TimeoutStartSec=3600

# No auto-restart: this is Type=oneshot (Restart= is a no-op for oneshot anyway), and
# a failed pipeline should stay failed and visible rather than silently re-run. Failure
# debugging comes via the orchestrator's run-report email (per-step warning/error
# counts + file:// log links; enable by setting the SMTP_* vars above), not blind
# retries. The probe fires each patch exactly once (GID dedup), so the next start is
# the next real patch.
