# WRF orchestrator secrets — EXAMPLE ONLY (safe to commit; no values).
#
# SERVER MODEL (differs from the WRFrontiersDB-Orchestrator repo's own example, which
# describes the WORKSTATION's ethan-owned-launcher bridge). This box has NO `ethan`
# user, and uses the standard home-server secrets convention instead:
#
#   /etc/home-server/wrf-orchestrator.env   (root-owned, chmod 600, hand-maintained)
#
# The pipeline runs as `dev`, but `dev` never reads this file at rest: the pipeline's
# systemd trigger service (User=dev) pulls the values in via `EnvironmentFile=`, which
# systemd reads as root and injects into the dev process's environment only — exactly
# how steam-tracker (/etc/home-server/steam-tracker.env) and restic (backup.env) work.
#
# Create it once, as root:
#   sudo install -m 600 /dev/null /etc/home-server/wrf-orchestrator.env
#   sudo editor /etc/home-server/wrf-orchestrator.env   # paste the three values below
#
# For a MANUAL pipeline run before the trigger service exists, launch as dev with the
# env injected by root (dev still never reads it at rest):
#   sudo systemd-run --pty --uid=dev --gid=dev \
#     -p EnvironmentFile=/etc/home-server/wrf-orchestrator.env \
#     --setenv=HOME=/home/dev \
#     /srv/dev/repos/WRFrontiersDB-Orchestrator/bin/run-pipeline --game-version YYYY-MM-DD ...

# Steam account used by the Exporter's DepotDownloader step.
STEAM_USERNAME=""
STEAM_PASSWORD=""

# Fine-grained PAT with push access to Surxe/WRFrontiersDB-Data (Parser push step).
GH_DATA_REPO_PAT=""

# Run-report email (OPTIONAL). After every run the orchestrator emails a report
# (per-step warning/error counts + file:// links to the logs). Enabled only when
# all three below are set; absent any, the report is just logged (no mail). These
# are the orchestrator's OWN var names (independent of steam-tracker); the same
# Gmail account + 16-char App Password can back both — each service env file on
# this box is self-contained (same convention as steam-tracker.env / backup.env).
# The systemd unit's EnvironmentFile loads every line here, so adding these three
# is all that's needed. SMTP_HOST/SMTP_PORT default to smtp.gmail.com:587 — set
# them here only to override.
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_TO=""
