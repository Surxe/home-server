[Unit]
Description=WRFrontiersDB Discord bot: [[name]] lookups of WRF data, linked to wrf-db.info
Documentation=https://github.com/Surxe/WRFrontiersDB-Discord-Bot
After=network-online.target
Wants=network-online.target
# The bot is a generic sibling clone; its venv is built by wrf-discord-bot/install.sh.
ConditionPathExists=/srv/dev/repos/WRFrontiersDB-Discord-Bot/.venv/bin/python
# No token, no bot: skip cleanly instead of crash-looping on a missing secret.
ConditionPathExists=/etc/home-server/wrf-discord-bot.env
# Stop retrying after 5 failed starts in 10 min (e.g. a revoked token), so a broken
# bot shows as failed instead of flapping forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# Runs as dev, who owns the clones. HOME is set so ~ resolves under systemd, matching
# the other hs-* dev units.
User=dev
Environment=HOME=/home/dev
WorkingDirectory=/srv/dev/repos/WRFrontiersDB-Discord-Bot
# Non-secret config is config-as-code, here (see the bot's .env.example for all options).
# DATA_DIR is the pipeline's WRFrontiersDB-Data clone: the bot only reads it, and
# reloads within DATA_REFRESH_MINUTES of each patch-day push.
Environment=DATA_DIR=/srv/dev/repos/WRFrontiersDB-Data
# The pipeline records each successful Site deploy here (its deploy record: run_id,
# data_commit, ...); the bot re-fetches the Site's meta descriptions (its embed text)
# once per new deploy.
Environment=SITE_DEPLOY_STATE=/srv/dev/repos/WRFrontiersDB-Orchestrator/data/site_deploy_state.json
# lookup = [[name]] + /wrf; about = /about (which Data commit the bot, Site and
# Visualizer are on; reads their /deploy.json, VISUALIZER_URL defaults in the bot);
# builds = replies to wrf-db.info /models build-code links with the builds' parts
# (decoded with the DATA_DIR clone's codec).
Environment=ENABLED_SERVICES=lookup,about,builds
# Server id(s) to sync the slash commands to (instant), comma-separated: Ethan's personal test server.
# Empty = global sync (up to an hour to appear).
Environment=GUILD_IDS=1043978430888300566
# DISCORD_BOT_TOKEN only (root-owned, chmod 600, created by hand from
# wrf-discord-bot/wrf-discord-bot.env.example — never committed). systemd reads it as
# root and injects it into the dev process; dev never reads the file at rest.
EnvironmentFile=/etc/home-server/wrf-discord-bot.env
ExecStart=/srv/dev/repos/WRFrontiersDB-Discord-Bot/.venv/bin/python -m wrfdb_bot
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wrf-discord-bot
# The bot only reads files (and git in DATA_DIR) and talks to Discord + the frontends;
# it writes nothing.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
