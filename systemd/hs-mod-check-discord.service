[Unit]
Description=home-server: Valheim mod-update check + Discord alert on change
Documentation=file:///srv/dev/repos/home-server/valheim/notify-mod-updates-discord.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Secret (Discord webhook URL) lives outside the repo. Leading '-' makes it optional so
# the timer doesn't hard-fail before the webhook is staged; the script then logs
# "DISCORD_WEBHOOK_URL not set" instead of posting.
EnvironmentFile=-/etc/home-server/mod-notify-discord.env
ExecStart=/srv/dev/repos/home-server/valheim/notify-mod-updates-discord.sh
Nice=10
