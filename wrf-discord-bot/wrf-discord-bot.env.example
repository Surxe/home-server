# WRFrontiersDB Discord bot token — TEMPLATE (location doc only).
#
# The LIVE file is /etc/home-server/wrf-discord-bot.env (root-owned, chmod 600),
# created BY HAND — never committed. This .example is the tracked template; never
# put the real token here. hs-wrf-discord-bot.service loads it via EnvironmentFile=
# and is skipped (ConditionPathExists) until it exists. All non-secret options
# (DATA_DIR, GUILD_IDS, ...) live in the unit, as config-as-code.
#
# Install (as root):
#   install -m 600 /dev/null /etc/home-server/wrf-discord-bot.env
#   editor /etc/home-server/wrf-discord-bot.env   # paste the token below
#   systemctl enable --now hs-wrf-discord-bot.service
#
# Token: Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=
